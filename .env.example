# Design by Dial admin panel (CMS for editable site content). Site slug: gsmcabinrentals.
ADMIN_PANEL_API_URL=
ADMIN_PANEL_API_KEY=

# Guesty dashboard -> Listings -> the cabin -> Calendar -> Calendar sync (iCal) -> Export Guesty calendar -> Copy link.
# Keep these private: the feeds include guests' reservation codes.
GUESTY_ICAL_BLUFF_RIDGE_HAVEN=
GUESTY_ICAL_PINE_TOP_VISTA=
GUESTY_ICAL_CABANA_ON_OSPREY=

# Guesty booking site that takes payment. Defaults to https://www.gsmcabinrentals.com.
NEXT_PUBLIC_BOOKING_ORIGIN=

# Contact form and booking requests. Gmail: smtp.gmail.com, port 587, and an App Password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Where messages are delivered. Defaults to gsmcabinrentals@gmail.com.
CONTACT_TO_EMAIL=
