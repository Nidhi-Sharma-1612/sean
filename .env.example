# Guesty dashboard -> Distribution -> Booking Engine API -> new API key.
# Without these the booking calendar still works but shows no live availability.
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=

# Contact form and booking requests. Gmail: smtp.gmail.com, port 587, and an App Password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Where messages are delivered. Defaults to gsmcabinrentals@gmail.com.
CONTACT_TO_EMAIL=
